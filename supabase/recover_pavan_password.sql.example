-- One-time recovery by the project owner in the Supabase SQL Editor.
-- Replace the placeholder privately. Never commit or share your chosen password.
-- This targets the existing account and preserves its ID, role and sales.
DO $$
DECLARE
  chosen_password text := 'REPLACE_WITH_YOUR_NEW_PRIVATE_PASSWORD';
BEGIN
  IF chosen_password = 'REPLACE_WITH_YOUR_NEW_PRIVATE_PASSWORD' OR length(chosen_password) < 8 THEN
    RAISE EXCEPTION 'Replace the placeholder with your own password of at least 8 characters';
  END IF;
  IF octet_length(chosen_password) > 72 THEN
    RAISE EXCEPTION 'Use a password of at most 72 bytes';
  END IF;

  UPDATE auth.users
  SET encrypted_password = extensions.crypt(chosen_password, extensions.gen_salt('bf', 10)),
      email_confirmed_at = COALESCE(email_confirmed_at, NOW()),
      confirmation_token = '',
      updated_at = NOW()
  WHERE lower(email) = 'pavan@time2trade.com';

  IF NOT FOUND THEN
    RAISE EXCEPTION 'Existing Auth account pavan@time2trade.com was not found. No account was created.';
  END IF;
END $$;
